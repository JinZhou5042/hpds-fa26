# Shared HTCondor submit description for all topic modules.
universe = vanilla

executable = /bin/bash
arguments = $(topic_dir)/../common/run_cuda_example.sh $(program) $(topic_dir) $(ClusterId).$(ProcId) $(program_args)
initialdir = $(topic_dir)

request_cpus = 1
request_memory = 4GB
request_disk = 2GB
request_gpus = 1
requirements = (OpSysAndVer == "RedHat9")

should_transfer_files = NO
notification = Never

output = condor/$(program).$(ClusterId).$(ProcId).out
error = condor/$(program).$(ClusterId).$(ProcId).err
log = condor/$(program).$(ClusterId).$(ProcId).log

queue 1
